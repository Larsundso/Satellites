{
  "name": "@ayako/satellites",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --copy-files",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm build && node --enable-source-maps ./dist/index.js --local",
    "lint": "eslint src --fix",
    "run": "node ./dist/index.js",
    "start": "pnpm run run",
    "watch": "swc src -d dist --strip-leading-paths --copy-files --watch"
  },
  "dependencies": {
    "@ayako/database": "workspace:*",
    "@ayako/utility": "workspace:*",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/ws": "^2.0.4",
    "@prisma/adapter-pg": "7.10.0",
    "discord-api-types": "0.38.55",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "1.16.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=25.6.0",
    "pnpm": ">=11.6.0"
  }
}
